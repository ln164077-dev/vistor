      });

      const closeInsuranceForm = () => {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      const openInsuranceForm = (type) => {
        activeInsuranceType = type || "car";
        carRequestType = "new";
        renderDynamicFields();
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        window.setTimeout(() => document.getElementById("customer-name").focus(), 40);
      };

      document.querySelectorAll(".insurance-trigger, .quick-action[data-insurance]").forEach((element) => {
        element.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          openInsuranceForm(element.dataset.insurance);
        });

        if (element.tagName !== "BUTTON") {
          element.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              openInsuranceForm(element.dataset.insurance);
            }
          });
        }
      });

      document.getElementById("form-close").addEventListener("click", closeInsuranceForm);
      document.getElementById("form-cancel").addEventListener("click", closeInsuranceForm);
      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeInsuranceForm();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.classList.contains("is-open")) {
          closeInsuranceForm();
        }
      });

      insuranceForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const renewalDate = document.getElementById("policy_renewal");
        if (renewalDate) {
          renewalDate.setCustomValidity(
            renewalDate.value && renewalDate.value >= minimumRenewalDate
              ? ""
              : html.lang === "en"
                ? "Choose a future renewal date."
                : "اختر تاريخًا مستقبليًا لتجديد الوثيقة."
          );
        }
        if (!insuranceForm.reportValidity()) return;

        const request = {
          insuranceType: activeInsuranceType,
          fields: Object.fromEntries(new FormData(insuranceForm).entries()),
          submittedAt: new Date().toISOString()
        };

        try {
          sessionStorage.setItem("qicInsuranceRequest", JSON.stringify(request));
          window.location.href = INSURANCE_FLOW_PAGE;
        } catch {
          const query = new URLSearchParams({ insuranceType: activeInsuranceType });
          window.location.href = `${INSURANCE_FLOW_PAGE}?${query.toString()}`;
        }
      });

      applyLanguage(savedLanguage);
    })();
