  <script>
    (() => {
      const html = document.documentElement;
      const languageButton = document.getElementById("language-toggle");
      const savedLanguage = (() => {
        try {
          return localStorage.getItem("qic-language") || "ar";
        } catch {
          return "ar";
        }
      })();

      const setOne = (selector, arabic, english, useHTML = false) => {
        const element = document.querySelector(selector);
        if (!element) return;
        element[useHTML ? "innerHTML" : "textContent"] =
          html.lang === "en" ? english : arabic;
      };

      const setList = (selector, arabic, english, useHTML = false) => {
        document.querySelectorAll(selector).forEach((element, index) => {
          const value = html.lang === "en" ? english[index] : arabic[index];
          if (value === undefined) return;
          element[useHTML ? "innerHTML" : "textContent"] = value;
        });
      };

      const translateBenefits = () => {
        const arabic = [
          "محتويات<br />المنزل",
          "الحوادث<br />الشخصية",
          "الفواتير<br />والشيكات",
          "الغوص",
          "الأعمال<br />التجارية",
          "الرسوم<br />الدراسية",
          "التقاعد",
          "التعليم",
          "حماية<br />الفواتير",
          "الأجهزة<br />المحمولة"
        ];
        const english = [
          "Home<br />contents",
          "Personal<br />accidents",
          "Bills<br />and cheques",
          "Diving",
          "Commercial<br />business",
          "School<br />fees",
          "Retirement",
          "Education",
          "Bill<br />protection",
          "Mobile<br />devices"
        ];
        document.querySelectorAll(".benefit").forEach((element, index) => {
          const icon = element.querySelector(".benefit-icon");
          element.innerHTML = `${icon.outerHTML}${html.lang === "en" ? english[index] : arabic[index]}`;
        });
      };

      // Change this path later to the page that will continue the insurance flow.
      const INSURANCE_FLOW_PAGE = "insurance-flow.html";
      const modal = document.getElementById("insurance-modal");
      const insuranceForm = document.getElementById("insurance-form");
      const dynamicFields = document.getElementById("dynamic-fields");
      let activeInsuranceType = "car";
      let carRequestType = "new";
      const formatDateForInput = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const minimumRenewalDate = formatDateForInput(tomorrow);

      const field = (label, name, type = "text", extra = "") => `
        <div class="form-field">
          <label for="${name}">${label}</label>
          <input id="${name}" name="${name}" type="${type}" ${extra} required />
        </div>
      `;

      const selectField = (label, name, options) => `
        <div class="form-field">
          <label for="${name}">${label}</label>
          <select id="${name}" name="${name}" required>
            ${options.map(([value, text]) => `<option value="${value}">${text}</option>`).join("")}
          </select>
        </div>
      `;

      const renderDynamicFields = () => {
        const english = html.lang === "en";
        const buyerFields = carRequestType === "ownership"
          ? english
            ? `${field("Buyer full name", "buyer_name")}${field("Buyer phone number", "buyer_phone", "tel", 'inputmode="tel"')}${field("Buyer national ID", "buyer_id", "text", 'inputmode="numeric"')}`
            : `${field("اسم المشتري", "buyer_name")}${field("رقم هاتف المشتري", "buyer_phone", "tel", 'inputmode="tel"')}${field("رقم هوية المشتري", "buyer_id", "text", 'inputmode="numeric"')}`
          : "";
        const fields = {
          car: {
            title: english ? "Insurance type: Car insurance" : "نوع التأمين: تأمين السيارة",
            html: english
              ? `
                <div class="radio-field">
                  <span class="form-legend">What do you need?</span>
                  <label class="radio-option"><input type="radio" name="car_request" value="new" ${carRequestType === "new" ? "checked" : ""} /><span>New insurance</span></label>
                  <label class="radio-option"><input type="radio" name="car_request" value="ownership" ${carRequestType === "ownership" ? "checked" : ""} /><span>Transfer ownership</span></label>
                </div>
                ${selectField("Coverage type", "coverage", [["comprehensive", "Comprehensive"], ["third-party", "Third-party"]])}
                ${field("Vehicle plate number", "plate")}
                ${field("Vehicle make and model", "vehicle", "text", 'placeholder="Example: Toyota Land Cruiser"')}
                ${field("Vehicle year", "vehicle_year", "number", 'min="1950" max="2030"')}
                ${field("Insurance policy renewal date", "policy_renewal", "date", `min="${minimumRenewalDate}"`)}
                ${buyerFields}
              `
              : `
                <div class="radio-field">
                  <span class="form-legend">ما الذي تحتاجه؟</span>
                  <label class="radio-option"><input type="radio" name="car_request" value="new" ${carRequestType === "new" ? "checked" : ""} /><span>تأمين جديد</span></label>
                  <label class="radio-option"><input type="radio" name="car_request" value="ownership" ${carRequestType === "ownership" ? "checked" : ""} /><span>نقل ملكية</span></label>
                </div>
                ${selectField("نوع التغطية", "coverage", [["comprehensive", "تأمين شامل"], ["third-party", "ضد الغير"]])}
                ${field("رقم لوحة السيارة", "plate")}
                ${field("نوع وموديل السيارة", "vehicle", "text", 'placeholder="مثال: تويوتا لاندكروزر"')}
                ${field("سنة الصنع", "vehicle_year", "number", 'min="1950" max="2030"')}
                ${field("تاريخ تجديد وثيقة التأمين", "policy_renewal", "date", `min="${minimumRenewalDate}"`)}
                ${buyerFields}
              `
          },
          travel: {
            title: english ? "Insurance type: Travel insurance" : "نوع التأمين: تأمين السفر",
            html: english
              ? `${field("Destination", "destination")}${field("Departure date", "departure", "date")}${field("Return date", "return", "date")}${field("Number of travellers", "travellers", "number", 'min="1"')}`
              : `${field("الوجهة", "destination")}${field("تاريخ المغادرة", "departure", "date")}${field("تاريخ العودة", "return", "date")}${field("عدد المسافرين", "travellers", "number", 'min="1"')}`
          },
          visitor: {
            title: english ? "Insurance type: Visitor insurance" : "نوع التأمين: تأمين الزائرين",
            html: english
              ? `${field("Nationality", "nationality")}${field("Passport number", "passport")}${field("Arrival date", "arrival", "date")}${field("Visit duration (days)", "duration", "number", 'min="1"')}`
              : `${field("الجنسية", "nationality")}${field("رقم جواز السفر", "passport")}${field("تاريخ الوصول", "arrival", "date")}${field("مدة الزيارة (بالأيام)", "duration", "number", 'min="1"')}`
          },
          "life-health": {
            title: english ? "Insurance type: Life & health insurance" : "نوع التأمين: التأمين على الحياة والصحة",
