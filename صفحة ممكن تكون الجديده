<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>أفضل شركة تأمين في قطر | QIC</title>
  <style>
    :root {
      --ink: #22212c;
      --muted: #7d7c89;
      --line: #ebeaf2;
      --purple: #5f5bee;
      --purple-dark: #4642d7;
      --soft-purple: #f1f1ff;
      --card: #f5f5ff;
      --white: #ffffff;
      --shadow: 0 10px 35px rgba(77, 70, 190, .10);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      margin: 0;
      background: #fff;
      color: var(--ink);
      font-family: Tahoma, Arial, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .page {
      width: min(1180px, calc(100% - 36px));
      margin: 0 auto;
      padding: 14px 0 34px;
    }

    /* Header */
    .topbar {
      position: relative;
      min-height: 54px;
      display: flex;
      align-items: center;
      gap: 18px;
      border-bottom: 1px solid #f4f3f7;
    }

    .mobile-menu {
      display: none;
      border: 0;
      padding: 0;
      background: transparent;
      color: #3f3e4c;
      font-size: 21px;
      line-height: 1;
      cursor: pointer;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 76px;
      color: #17162b;
      font: italic 800 26px Georgia, serif;
      letter-spacing: -3px;
    }

    .nav {
      flex: 1;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 28px;
      color: #454451;
      font-size: 13px;
      white-space: nowrap;
    }

    .nav a {
      transition: color .2s ease;
    }

    .nav a:hover {
      color: var(--purple);
    }

    .nav a.has-arrow::after {
      content: "⌄";
      margin-right: 7px;
      color: #282735;
      font-size: 14px;
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 8px;
      direction: ltr;
    }

    .action {
      height: 38px;
      padding: 0 14px;
      border: 1px solid #e3e2ea;
      border-radius: 8px;
      background: var(--white);
      color: #33323d;
      font-size: 12px;
      cursor: pointer;
    }

    .action.primary {
      border-color: var(--purple);
      background: var(--purple);
      color: #fff;
      box-shadow: 0 6px 14px rgba(95, 91, 238, .20);
    }

    .action.lang {
      width: 38px;
      padding: 0;
      font-size: 12px;
    }

    /* Page heading */
    .heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      margin: 36px 2px 20px;
    }

    .heading h1 {
      margin: 0;
      font-size: clamp(30px, 4vw, 48px);
      line-height: 1.15;
      letter-spacing: -1.6px;
      font-weight: 800;
    }

    .award {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #858490;
      font-size: 12px;
    }

    .award .trophy {
      color: #8d8b9a;
      font-size: 18px;
    }

    .mobile-quick-actions {
      display: none;
    }

    /* Main promotional layout */
    .promos {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      grid-template-areas:
        "side hero"
        "side offers";
      gap: 12px;
      direction: ltr;
    }

    .hero-card,
    .side-column,
    .offer-card {
      direction: rtl;
    }

    .side-column {
      grid-area: side;
      display: grid;
      grid-template-rows: 1fr 1fr;
      gap: 12px;
    }

    .mini-card,
    .offer-card,
    .hero-card {
      overflow: hidden;
      position: relative;
      border-radius: var(--radius);
    }

    .mini-card {
      min-height: 174px;
      padding: 18px 17px;
      color: #fff;
      isolation: isolate;
    }

    .family-card {
      background:
        radial-gradient(circle at 70% 78%, rgba(255,255,255,.22) 0 12%, transparent 13%),
        linear-gradient(140deg, #82b4e9 0%, #5b83bd 52%, #738dc4 100%);
    }

    .family-image {
      position: absolute;
      z-index: 0;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: .92;
    }

    .market-card {
      color: #272638;
      background:
        radial-gradient(ellipse at 50% 116%, #ffbd48 0 15%, transparent 16%),
        radial-gradient(ellipse at 18% 116%, #4582dc 0 15%, transparent 16%),
        linear-gradient(180deg, #f7f8ff 0%, #e9ebfa 100%);
    }

    .mini-card::after {
      content: "";
      position: absolute;
      inset: auto -8px -30px 0;
      height: 100px;
      border-radius: 50% 50% 0 0;
      background: rgba(255,255,255,.13);
      z-index: -1;
    }

    .mini-card h2 {
      position: relative;
      z-index: 2;
      margin: 0;
      font-size: 20px;
      line-height: 1.3;
    }

    .mini-card p {
      position: relative;
      z-index: 2;
      margin: 6px 0 0;
      font-size: 11px;
      line-height: 1.7;
      opacity: .94;
    }

    .family-people {
      position: absolute;
      left: 6px;
      bottom: -5px;
      display: flex;
      align-items: end;
      gap: 2px;
      height: 110px;
      direction: ltr;
    }

    .person {
      position: relative;
      width: 45px;
      height: 90px;
      border-radius: 24px 24px 9px 9px;
      background: #fff;
      box-shadow: 0 4px 12px rgba(32, 44, 83, .12);
    }

    .person::before {
      content: "";
      position: absolute;
      left: 8px;
      top: -20px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e4a77e;
    }

    .person.dad {
      height: 77px;
      background: #2d3d5e;
    }

    .person.dad::before {
      background: #a76545;
    }

    .person.child {
      width: 31px;
      height: 60px;
      background: #e8c15a;
    }

    .person.child::before {
      left: 5px;
      width: 21px;
      height: 21px;
      background: #b97651;
    }

    .person.mom {
      width: 39px;
      height: 85px;
      background: #d8b8cf;
    }

    .person.mom::before {
      background: #8d5b48;
      box-shadow: 0 -9px 0 7px #3e3550;
    }

    .market-card .market-title {
      position: relative;
      z-index: 2;
      margin: 0;
      font-size: 21px;
      font-weight: 800;
    }

    .market-card .market-subtitle {
      position: relative;
      z-index: 2;
      margin: 4px 0;
      color: #716f82;
      font-size: 11px;
    }

    .market-image {
      position: absolute;
      left: 3px;
      right: 3px;
      bottom: -2px;
      z-index: 1;
      width: calc(100% - 6px);
      height: 82px;
      object-fit: contain;
      object-position: center bottom;
    }

    .cars {
      position: absolute;
      left: 11px;
      right: 13px;
      bottom: 8px;
      height: 72px;
    }

    .car {
      position: absolute;
      bottom: 0;
      width: 96px;
      height: 31px;
      border-radius: 21px 24px 8px 8px;
      background: #fff;
      border: 2px solid rgba(44, 53, 92, .25);
      box-shadow: 0 6px 10px rgba(41, 50, 91, .15);
    }

    .car::before {
      content: "";
      position: absolute;
      width: 47px;
      height: 21px;
      left: 22px;
      top: -17px;
      border-radius: 22px 28px 0 0;
      background: inherit;
      border: 2px solid rgba(44, 53, 92, .25);
      border-bottom: 0;
    }

    .car::after {
      content: "●  ●";
      position: absolute;
      left: 16px;
      bottom: -10px;
      width: 70px;
      color: #414250;
      font-size: 18px;
      letter-spacing: 22px;
    }

    .car.blue {
      left: 0;
      background: #2779d9;
      transform: scale(.82);
      transform-origin: bottom left;
    }

    .car.white {
      left: 65px;
      bottom: 4px;
    }

    .car.yellow {
      right: 0;
      background: #f3aa21;
      transform: scale(.82);
      transform-origin: bottom right;
    }

    .hero-card {
      grid-area: hero;
      min-height: 267px;
      padding: 28px 33px;
      color: #fff;
      background:
        radial-gradient(circle at 58% 34%, rgba(255,255,255,.18) 0 3%, transparent 4%),
        linear-gradient(110deg, #7774ff 0%, #5e5beb 55%, #6764f5 100%);
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      max-width: 235px;
      margin-right: auto;
    }

    .hero-copy h2 {
      margin: 0;
      font-size: 29px;
      line-height: 1.2;
    }

    .hero-copy p {
      margin: 7px 0 0;
      color: #e7e7ff;
      font-size: 14px;
    }

    .hero-copy .buy {
      margin-top: 78px;
      height: 46px;
      padding: 0 27px;
      border: 0;
      border-radius: 11px;
      background: #fff;
      color: #383550;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 8px 16px rgba(43, 40, 145, .15);
    }

    .suv {
      position: absolute;
      left: 29px;
      bottom: 30px;
      width: min(52%, 410px);
      height: 125px;
      border-radius: 42% 24% 15% 15%;
      background: linear-gradient(180deg, #fff 0%, #e8e9f6 80%);
      border: 2px solid rgba(54, 49, 101, .18);
      transform: skewX(-7deg);
      box-shadow: 0 22px 20px rgba(45, 42, 129, .24);
    }

    .suv-image {
      position: absolute;
      z-index: 1;
      left: 1%;
      bottom: 12px;
      width: min(62%, 480px);
      height: auto;
      filter: drop-shadow(0 15px 10px rgba(45, 42, 129, .24));
    }

    .suv::before {
      content: "";
      position: absolute;
      left: 55px;
      top: -53px;
      width: 220px;
      height: 69px;
      border-radius: 90px 110px 4px 4px;
      background: linear-gradient(110deg, #414263, #aeb8d2);
      border: 4px solid #f9f9ff;
      box-shadow: inset 0 0 0 2px rgba(35, 36, 67, .2);
    }

    .suv::after {
      content: "●       ●";
      position: absolute;
      bottom: -24px;
      left: 74px;
      color: #303346;
      font-size: 38px;
      letter-spacing: 33px;
      transform: skewX(7deg);
    }

    .coins {
      position: absolute;
      left: 33px;
      bottom: 8px;
      display: flex;
      align-items: end;
      gap: 4px;
      transform: rotate(-12deg);
    }

    .coin {
      width: 61px;
      height: 61px;
      border-radius: 50%;
      border: 5px solid #f9c9eb;
      background: radial-gradient(circle at 35% 30%, #fff, #b995ed 62%, #6b4fc6 100%);
      box-shadow: 0 8px 10px rgba(45, 35, 115, .25);
    }

    .coin.small {
      width: 43px;
      height: 43px;
      margin-bottom: -3px;
    }

    .offers {
      grid-area: offers;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .offer-card {
      min-height: 116px;
      padding: 20px 24px;
      background: linear-gradient(105deg, #f7f7ff 0%, #f0efff 100%);
    }

    .offer-card h3 {
      margin: 0;
      font-size: 20px;
    }

    .offer-card p {
      margin: 7px 0 0;
      color: #858493;
      font-size: 12px;
    }

    .offer-art {
      position: absolute;
      left: 4px;
      bottom: -16px;
      width: 160px;
      height: 106px;
      opacity: .9;
    }

    .offer-image {
      position: absolute;
      z-index: 1;
      left: 2px;
      bottom: -10px;
      width: 46%;
      height: 118%;
      object-fit: contain;
      object-position: center bottom;
      filter: drop-shadow(0 7px 8px rgba(63, 57, 147, .12));
    }

    .globe {
      border-radius: 50%;
      background:
        radial-gradient(circle at 38% 28%, #f3baf2 0 5%, transparent 6%),
        radial-gradient(ellipse at 52% 50%, #6b58da 0 22%, transparent 23%),
        linear-gradient(150deg, #d9dcff, #7160e8);
      box-shadow: inset 19px 8px 0 rgba(255,255,255,.26);
    }

    .pin {
      position: absolute;
      top: 1px;
      left: 67px;
      width: 34px;
      height: 44px;
      border-radius: 50% 50% 50% 0;
      background: linear-gradient(140deg, #f6b9ea, #8175e9);
      transform: rotate(-45deg);
      box-shadow: 0 8px 8px rgba(60, 50, 147, .17);
    }

    .pin::after {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      top: 11px;
      left: 11px;
      border-radius: 50%;
      background: #fff;
    }

    .umbrella {
      position: absolute;
      left: 22px;
      bottom: 10px;
      width: 96px;
      height: 47px;
      border-radius: 100px 100px 0 0;
      background: linear-gradient(110deg, #9d8cf4 20%, #cdbdfd 21% 37%, #8a7fe9 38% 55%, #c5bbff 56% 76%, #776de1 77%);
      transform: rotate(-20deg);
    }

    .umbrella::after {
      content: "";
      position: absolute;
      left: 46px;
      top: 35px;
      width: 3px;
      height: 75px;
      background: #716c9e;
      transform: rotate(10deg);
      transform-origin: top;
    }

    /* Benefits */
    .benefits {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 10px;
      margin-top: 14px;
      padding-top: 0;
    }

    .benefit {
      min-width: 0;
      text-align: center;
      color: #53515f;
      font-size: 12px;
      line-height: 1.55;
    }

    .benefit-icon {
      width: 62px;
      height: 62px;
      display: grid;
      place-items: center;
      margin: 0 auto 8px;
      border-radius: 13px;
      color: #5758d9;
      background: linear-gradient(145deg, #f1f1ff, #e9e9ff);
      box-shadow: inset 0 0 0 1px rgba(107, 101, 228, .06);
      font-size: 31px;
    }

    .benefit-icon span {
      filter: drop-shadow(2px 3px 0 rgba(139, 123, 239, .20));
    }

    /* Lower page components */
    .lower-content {
      margin-top: 48px;
    }

    .app-banner {
      position: relative;
      min-height: 126px;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding: 20px 58px 20px 36%;
      border-radius: 18px;
      color: #fff;
      background:
        radial-gradient(circle at 27% 105%, rgba(218, 220, 255, .65) 0 17%, transparent 18%),
        linear-gradient(105deg, #7776ec 0%, #7775ef 50%, #5c5be7 100%);
    }

    .app-copy {
      position: relative;
      z-index: 2;
      text-align: right;
    }

    .app-copy h2 {
      margin: 0;
      font-size: clamp(22px, 3vw, 31px);
      line-height: 1.25;
    }

    .app-copy p {
      margin: 6px 0 13px;
      color: #eeefff;
      font-size: 13px;
    }

    .app-button {
      padding: 8px 21px;
      border: 0;
      border-radius: 7px;
      background: #fff;
      color: #4c4a8a;
      font-size: 12px;
      cursor: pointer;
    }

    .app-phone {
      position: absolute;
      z-index: 3;
      left: 17%;
      bottom: -34px;
      width: 116px;
      height: 168px;
      padding: 16px 7px 8px;
      border: 4px solid #1d1d2b;
      border-radius: 21px;
      background: #fafaff;
      box-shadow: 0 12px 16px rgba(43, 40, 128, .28);
      transform: rotate(-1deg);
    }

    .app-phone::before {
      content: "";
      position: absolute;
      top: 5px;
      left: 50%;
      width: 38px;
      height: 8px;
      border-radius: 0 0 9px 9px;
      background: #1d1d2b;
      transform: translateX(-50%);
    }

    .phone-screen {
      height: 100%;
      overflow: hidden;
      border-radius: 10px;
      background:
        linear-gradient(145deg, transparent 0 34%, rgba(250, 188, 104, .45) 35% 48%, transparent 49%),
        linear-gradient(180deg, #f1f4ff 0 18%, #fff 19% 100%);
    }

    .phone-top {
      display: flex;
      justify-content: space-between;
      padding: 7px 5px 5px;
      color: #38375a;
      font-size: 6px;
      font-weight: 700;
    }

    .phone-card {
      height: 46px;
      margin: 7px 6px;
      border-radius: 6px;
      background:
        linear-gradient(150deg, transparent 0 42%, rgba(101, 98, 231, .8) 43% 57%, transparent 58%),
        linear-gradient(120deg, #7c78ef, #dce0ff);
    }

    .phone-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      padding: 4px 6px;
    }

    .phone-row span {
      height: 19px;
      border-radius: 4px;
      background: #ececff;
    }

    .phone-row span:nth-child(2) {
      background: #ffe9d4;
    }

    .phone-row span:nth-child(3) {
      background: #dbf3e4;
    }

    .app-mark {
      position: absolute;
      z-index: 4;
      left: 22%;
      top: 50%;
      display: grid;
      place-items: center;
      min-width: 91px;
      height: 47px;
      padding: 0 12px;
      border: 5px solid #fff;
      border-radius: 17px;
      background: #605ce9;
      color: #fff;
      font-size: 20px;
      font-weight: 800;
      box-shadow: 0 5px 12px rgba(48, 44, 150, .22);
      transform: translateY(-50%);
    }

    .qr {
      position: absolute;
      z-index: 4;
      left: 29%;
      top: 50%;
      width: 43px;
      height: 43px;
      border: 5px solid #fff;
      border-radius: 4px;
      background:
        linear-gradient(90deg, #4644b3 25%, transparent 25% 50%, #4644b3 50% 75%, transparent 75%),
        linear-gradient(#4644b3 25%, transparent 25% 50%, #4644b3 50% 75%, transparent 75%);
      background-size: 12px 12px;
      transform: translateY(-50%);
    }

    .side-control {
      position: absolute;
      z-index: 5;
      left: 10px;
      top: 8px;
      bottom: 8px;
      width: 28px;
      display: flex;
      align-items: center;
      flex-direction: column;
      gap: 6px;
    }

    .side-control b {
      display: grid;
      place-items: center;
      width: 21px;
      height: 21px;
      border-radius: 50%;
      background: rgba(255,255,255,.93);
      color: #7774c7;
      font-size: 13px;
    }

    .side-control i {
      flex: 1;
      width: 9px;
      min-height: 35px;
      border-radius: 8px;
      background: rgba(255,255,255,.94);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      padding: 62px 34px 69px;
      text-align: center;
    }

    .stat {
      color: #72717e;
      font-size: 11px;
    }

    .stat-value {
      min-height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #292833;
      font-size: clamp(30px, 4vw, 43px);
      font-weight: 900;
      letter-spacing: -2px;
      line-height: 1;
    }

    .stat-value.aaa {
      font-family: Arial, sans-serif;
      font-style: italic;
      letter-spacing: -5px;
    }

    .stat-value.since {
      display: grid;
      grid-template-columns: auto auto;
      grid-template-rows: 1fr 1fr;
      column-gap: 3px;
      align-items: center;
      justify-content: center;
      letter-spacing: -3px;
    }

    .since-small {
      align-self: end;
      margin-bottom: 1px;
      font-size: 12px;
      letter-spacing: 0;
    }

    .year-top {
      grid-column: 1;
      grid-row: 1;
    }

    .year-bottom {
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
    }

    .stat-value.rating {
      gap: 3px;
    }

    .star {
      color: #2a2937;
      font-size: 26px;
    }

    .stat-label {
      margin-top: 13px;
    }

    .award-banner {
      position: relative;
      min-height: 153px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px 150px 20px 90px;
      border-radius: 18px;
      background: linear-gradient(100deg, #f5f5ff, #f0efff);
    }

    .award-banner .side-control {
      top: 19px;
      bottom: 19px;
    }

    .award-title {
      margin: 0;
      color: #252431;
      text-align: center;
      font-size: clamp(30px, 5vw, 50px);
      line-height: 1.13;
      letter-spacing: -1.5px;
    }

    .award-shield {
      position: absolute;
      right: 33px;
      top: 50%;
      width: 113px;
      height: 124px;
      border-radius: 52% 52% 43% 43% / 43% 43% 58% 58%;
      background: linear-gradient(145deg, #a39bf6, #716ae8);
      box-shadow: 0 9px 12px rgba(67, 58, 181, .15);
      transform: translateY(-54%);
      clip-path: polygon(50% 0, 68% 13%, 91% 16%, 92% 61%, 82% 79%, 50% 100%, 18% 79%, 8% 61%, 9% 16%, 32% 13%);
    }

    .award-shield::before {
      content: "★";
      position: absolute;
      inset: 14px 0 0;
      color: #fff;
      text-align: center;
      font-size: 58px;
      line-height: 1.15;
    }

    .award-ribbon {
      position: absolute;
      right: 54px;
      bottom: 7px;
      z-index: 2;
      width: 30px;
      height: 40px;
